--- /dev/null
+++ b/DasharoPayloadPkg/SecCore/edkii_vga.c
@@ -0,0 +1,151 @@
+
+#include "edkii_vga.h"
+
+
+/////////////////////////////////////////////////////
+
+#include <stdarg.h> 
+
+#include <Library/IoLib.h>
+#include <Library/PrintLib.h>
