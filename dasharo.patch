+void mn_6_delay_s(int n)
+{
+  volatile unsigned long t = 25;
+  volatile unsigned long x = (unsigned long)n * 10000UL;
+
+  while (x--) {
+    for (unsigned long i1 = 0; i1 < 1000UL; ++i1) {
+        for (int i = 0; i < 10; ++i) {
+            t = t * 14823424UL + x + 1UL;
+        }
+    }
+  }
+
+  mde_6_edkii_vga_sprintf(23, "%x", t);
+}
