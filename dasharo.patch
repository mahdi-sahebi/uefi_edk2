-IsIa32PaeSupport (
-  VOID
-  )
-{
-  UINT32   RegEax;
-  UINT32   RegEdx;
-  BOOLEAN  Ia32PaeSupport;
-
-  Ia32PaeSupport = FALSE;
-  AsmCpuid (0x0, &RegEax, NULL, NULL, NULL);
-  if (RegEax >= 0x1) {
-    AsmCpuid (0x1, NULL, NULL, NULL, &RegEdx);
-    if ((RegEdx & BIT6) != 0) {
-      Ia32PaeSupport = TRUE;
-    }
-  }
-
-  return Ia32PaeSupport;
-}
