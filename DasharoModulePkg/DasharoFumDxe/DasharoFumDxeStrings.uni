///** @file
//  String definitions for the Dasharo Firmware Update Mode setup menu.
//**/

#langdef   en-US "English"

#string STR_FUM_TITLE    #language en-US  "Firmware Update Mode"
#string STR_FUM_PROMPT   #language en-US  "> Enter Firmware Update Mode"
#string STR_FUM_HELP     #language en-US  "Disables all firmware protections for the duration of next boot."
#string STR_FUM_WARN_1   #language en-US  "You are about to enable Firmware Update Mode."
#string STR_FUM_WARN_2   #language en-US  "This will turn off all flash protection mechanisms"
#string STR_FUM_WARN_3   #language en-US  "for the duration of the next boot."
#string STR_FUM_BLANK    #language en-US  ""
#string STR_FUM_IPXE_1   #language en-US  "DTS will be started automatically through iPXE, please"
#string STR_FUM_IPXE_2   #language en-US  "make sure an Ethernet cable is connected before continuing."
