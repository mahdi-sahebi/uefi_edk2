#include "DasharoFumDxeHii.h"

formset
  guid      = DASHARO_FUM_FORMSET_GUID,
  title     = STRING_TOKEN(STR_FUM_TITLE),
  help      = STRING_TOKEN(STR_FUM_HELP),
  classguid = gEfiIfrFrontPageGuid,

  form formid = DASHARO_FUM_FORM_ID,
       title  = STRING_TOKEN(STR_FUM_TITLE);

    text
      help  = STRING_TOKEN(STR_FUM_HELP),
      text  = STRING_TOKEN(STR_FUM_PROMPT),
      flags = INTERACTIVE,
      key   = FIRMWARE_UPDATE_MODE_QUESTION_ID;

  endform;

endformset;
